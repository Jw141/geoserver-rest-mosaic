# Copy to .env and adjust.  Every value has a working default in
# docker-compose.yml, so the stack runs without this file.

# --- GeoServer ---------------------------------------------------------------
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver
# Kartoza image tags track GeoServer releases; check Docker Hub for what is
# actually published before pinning.
GS2_VERSION=2.28.4
GS3_VERSION=3.0.0
GS2_PORT=8080
GS3_PORT=8081
GS_INITIAL_MEMORY=512M
GS_MAXIMUM_MEMORY=2G

# COG ships as four independent community packages, one per connection type:
# cog-http-plugin, cog-s3-plugin, cog-azure-plugin, cog-google-plugin.
# Swap cog-s3-plugin for azure/google as needed -- but never combine two cloud
# providers, their dependencies conflict. `make check` reports what installed.
GS_STABLE_EXTENSIONS=
GS_COMMUNITY_EXTENSIONS=cog-http-plugin,cog-s3-plugin

# S3 only? cog-s3-plugin is self-contained, so this is all you need -- and set
# COG_RANGE_READER=S3 below so the demo's remote mosaic uses s3:// URLs.
# Keeping cog-http-plugin as well costs nothing and gives you a working control
# when debugging S3 endpoint problems; see docker/README.md.
# GS_COMMUNITY_EXTENSIONS=cog-s3-plugin

# --- PostGIS -----------------------------------------------------------------
PG_DATABASE=gis
PG_USER=gis
PG_PASSWORD=gis
PG_PORT=5432

# --- LocalStack S3 -----------------------------------------------------------
# LocalStack accepts any credentials; these are passed to GeoServer as the
# IIO_S3_AWS_USER / IIO_S3_AWS_PASSWORD the COG S3 range reader actually reads.
S3_BUCKET=mosaic-tiles
S3_PORT=4566

# LocalStack images published from 2026-03-23 require an auth token even for S3.
# This pin predates that, so the stack runs token-free out of the box. To move
# to a newer image, get a token (the free tier issues them at
# https://app.localstack.cloud) and uncomment LOCALSTACK_AUTH_TOKEN.
LOCALSTACK_VERSION=3
# LOCALSTACK_AUTH_TOKEN=ls-...
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# COG range reader tuning (imageio-ext). The compose file sets
# IIO_S3_AWS_ENDPOINT to the LocalStack address and forces path-style bucket
# addressing, which LocalStack and MinIO require. Set this to false when
# pointing at real AWS S3.
IIO_S3_AWS_FORCE_PATH_STYLE=true
# Raise these if a large mosaic saturates the HTTP connection pool.
IIO_HTTP_MAX_REQUESTS=128
IIO_HTTP_MAX_REQUESTS_PER_HOST=16

# --- Driver ------------------------------------------------------------------
# Range reader for the demo's remote mosaic: HTTP (default) or S3.
COG_RANGE_READER=HTTP

# These are resolved by GeoServer, from inside the compose network, so they use
# container names rather than localhost.  Change them only if you point the
# driver at a GeoServer running somewhere else.
GEOSERVER_URL=http://localhost:8080/geoserver
PG_HOST_FROM_GEOSERVER=postgis
# Schema for the index tables.  The Makefile sets gs2 or gs3 from GS= so the two
# GeoServers, which share one PostGIS, never touch each other's tables; set it
# here only when running the driver without make.  `make pg-schemas` creates both.
# PG_SCHEMA=gs2
S3_BASE_FROM_GEOSERVER=http://localstack:4566/mosaic-tiles
GRANULE_DIR_IN_GEOSERVER=/opt/granules
